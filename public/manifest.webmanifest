{
    "name": "Wishlist",
    "short_name": "Wishlist",
    "start_url": "/",
    "scope": "/",
    "display": "standalone",
    "background_color": "#0b1a13",
    "theme_color": "#1d583b",
    "icons": [
        { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
        { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
        { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml" }
    ],
    "share_target": {
        "action": "/wishlist-items/create",
        "method": "GET",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url"
        }
    }
}
